# Copy to .env and fill in. Never commit .env.

# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
# Cheapest model by default. Switch to claude-sonnet-5-5 if it misunderstands too often.
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low

# --- Who can use it (international format, no +) ---
# Mom's number, plus yours if you want to test.
ALLOWED_NUMBERS=91XXXXXXXXXX
# Gets a WhatsApp copy of every order placed.
OWNER_NUMBERS=91XXXXXXXXXX

# --- Spending limits (rupees) ---
MAX_ORDER_RUPEES=1500
WEEKLY_CAP_RUPEES=5000

# --- Delivery ---
HOME_PINCODE=

# --- Payment: prepaid only, cash on delivery is always refused ---
# wallet = the app's prepaid wallet (Zepto Cash), topped up by you; no PIN needed.
# upi    = a UPI payment link sent to PAYER_NUMBERS; a person pays with their PIN.
ALLOWED_PAYMENT_METHODS=wallet,upi
DEFAULT_PAYMENT=wallet
# Who gets UPI payment links (defaults to OWNER_NUMBERS).
PAYER_NUMBERS=

# --- Limits ---
MAX_MESSAGES_PER_HOUR=40
DATA_RETENTION_DAYS=90

# --- Read receipts ---
# If she hasn't opened a price quote after this many minutes, the voice note is sent again.
# After READ_REMINDER_MAX reminders, OWNER_NUMBERS get a message to call her. 0 turns this off
# (do that if her WhatsApp has read receipts switched off, or she will be reminded every time).
READ_REMINDER_MINUTES=10
READ_REMINDER_MAX=1

# --- Sarvam AI speech (https://dashboard.sarvam.ai) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_SPEAKER=anushka

# --- WhatsApp Cloud API (https://developers.facebook.com, WhatsApp > API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; enter the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret. Used to reject fake webhook calls.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# --- Storage ---
DB_PATH=data/agent.db
SERVERS_FILE=servers.json
